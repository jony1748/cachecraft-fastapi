APP_NAME=CacheCraft API
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./cachecraft.db
TRANSFORMER_DELAY_SECONDS=0
CACHE_CLEANUP_INTERVAL_SECONDS=3600
CACHE_TTL_SECONDS=86400
API_PREFIX=/api/v1
API_PORT=8000
POSTGRES_DB=cachecraft
POSTGRES_USER=cachecraft
POSTGRES_PASSWORD=replace-with-a-strong-secret
